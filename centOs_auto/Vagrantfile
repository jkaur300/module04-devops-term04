
# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "eurolinux-vagrant/centos-stream-9"
  config.vm.hostname = "jaspreet"

  config.vm.network "private_network", ip: "192.168.56.14"
  config.vm.network "forwarded_port", guest: 3000, host: 3000, auto_correct: true
  config.vm.network "forwarded_port", guest: 5090, host: 5090, auto_correct: true

  # Copy Student Portfolio and BankingApp into the VM
  config.vm.synced_folder "../Studentportfoliotemplate_Auto",
    "/home/vagrant/Studentportfoliotemplate",
    type: "rsync"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    set -e

    # Update system and install prerequisites
    sudo dnf install -y dnf-plugins-core git curl

    # Install Docker (official method for CentOS Stream 9)
    sudo dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
    sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    # Start and enable Docker
    sudo systemctl enable --now docker

    # Add vagrant user to docker group
    sudo usermod -aG docker vagrant

    # Create docker-compose.yml
    cat <<EOL > /home/vagrant/docker-compose.yml
services:
  studentportfolio:
    build:
      context: /home/vagrant/Studentportfoliotemplate
    ports:
      - "3000:80"
    networks:
      - prfnet
    hostname: studentportfolio
    container_name: studentportfolio
    restart: unless-stopped

  bankingapp:
    build:
      context: /home/vagrant/Studentportfoliotemplate/BankingApp
    ports:
      - "5090:5090"
    networks:
      - prfnet
    hostname: bankingapp
    container_name: bankingapp
    restart: unless-stopped

networks:
  prfnet:
    driver: bridge
EOL

    # Fix permissions
    sudo chown vagrant:vagrant /home/vagrant/docker-compose.yml

    # Start containers
    cd /home/vagrant
    sudo docker compose -p studentportfoliotemplate up -d --build

    # Check containers
    sudo docker ps
  SHELL
end
